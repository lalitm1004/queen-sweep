{
  "name": "queen-sweep-extension",
  "version": "0.1.0",
  "description": "Solve LinkedIn Queens in the browser",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/queen-sweep-wasm --release --target web --out-dir ../../queen-sweep-extension/src/wasm",
    "build:js": "vite build && node move-html.js",
    "build": "npm run build:wasm && npm run build:js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/chrome": "^0.1.27",
    "@types/node": "^24.9.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
